  "cards": [
    {
      "dot": "cyan",
      "title": "入口原则",
      "items": [
        "Node/Nitro 仍是唯一公网入口与默认 owner。",
        "Go 只处理显式登记且通过 readiness 的 operation。"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享状态",
      "items": [
        "SQLite 保存业务真相，Redis 保存跨进程运行态。",
        "对象存储保存原图、派生图、Live Photo 与视频资源。"
      ]
    },
    {
      "dot": "amber",
      "title": "迁移安全",
      "items": [
        "切换 Go 前校验 DB、Redis 和媒体工具链。",
        "迁移、队列 consumer、备份 scheduler 均要求单 owner。"
      ]
    }
  ]
